# SPDX-License-Identifier: MIT
[Unit]
Description=P32Firmware web site and flasher (p32firmware.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=p32firmware
Group=p32firmware
ExecStart=/opt/p32firmware/p32firmware-web -domain p32firmware.com -email sarahroselives@protonmail.com -cache /var/lib/p32firmware/autocert
Restart=on-failure
RestartSec=5s
StateDirectory=p32firmware
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077

[Install]
WantedBy=multi-user.target
